<!--
  Əsas pəncərə: yuxarıda məlumat sətri, aşağıda vəziyyət sətri,
  solda yüklənmiş faylların siyahısı, sağda seçilmiş faylın ticarət cədvəli.
  Sağdakı cədvəl birbaşa soldakı seçilmiş faylın Trades siyahısına bağlanıb (Binding), əlavə kod lazım deyil.
-->
<Window x:Class="TradeMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trade File Monitor" Height="600" Width="1000"
        Loaded="Window_Loaded">

    <DockPanel Margin="10">

        <TextBlock x:Name="InfoText" DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap" />

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,10,0,0" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Loaded files" Grid.Column="0" Margin="0,0,10,0">
                <ListBox x:Name="FilesList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding FileName}" FontWeight="Bold" />
                                <TextBlock>
                                    <Run Text="{Binding LoaderName, Mode=OneWay}" />
                                    <Run Text=" | " />
                                    <Run Text="{Binding Status, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <GroupBox Header="Trades" Grid.Column="1">
                <DataGrid ItemsSource="{Binding SelectedItem.Trades, ElementName=FilesList}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="*" />
                        <DataGridTextColumn Header="Open" Binding="{Binding Open}" Width="*" />
                        <DataGridTextColumn Header="High" Binding="{Binding High}" Width="*" />
                        <DataGridTextColumn Header="Low" Binding="{Binding Low}" Width="*" />
                        <DataGridTextColumn Header="Close" Binding="{Binding Close}" Width="*" />
                        <DataGridTextColumn Header="Volume" Binding="{Binding Volume}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
