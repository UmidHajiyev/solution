metry"/></mxCell><mxCell id="p1c22" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1c9" target="p1c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c23" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;rounded=0;fontSize=11;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1c10" target="p1c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c24" value="Redis&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;cache: last transactions&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="470.0" width="170" height="60" as="geometry"/></mxCell><mxCell id="p1c25" value="" style="endArrow=none;html=1;dashed=1;" edge="1" parent="1" source="p1c11" target="p1c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c26" value="RabbitMQ&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;events&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="750.0" width="820" height="60" as="geometry"/></mxCell><mxCell id="p1c27" value="ProfileUpdated" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;rounded=0;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=11;exitX=0.75;exitY=1;entryX=0.183;entryY=0;" edge="1" parent="1" source="p1c9" target="p1c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c28" value="DocumentUploaded" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;rounded=0;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=11;exitX=0.75;exitY=1;entryX=0.561;entryY=0;" edge="1" parent="1" source="p1c10" target="p1c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c29" value="TransactionCreated" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;rounded=0;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=11;exitX=0.75;exitY=1;entryX=0.939;entryY=0;" edge="1" parent="1" source="p1c11" target="p1c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c30" value="Notification Service&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;SMS / push&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="880.0" width="200" height="60" as="geometry"/></mxCell><mxCell id="p1c31" value="Audit Service&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;keeps history&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="880.0" width="200" height="60" as="geometry"/></mxCell><mxCell id="p1c32" value="Audit DB&lt;br&gt;(Oracle)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="875.0" width="100" height="70" as="geometry"/></mxCell><mxCell id="p1c33" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;rounded=0;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=11;" edge="1" parent="1" source="p1c26" target="p1c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c34" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;rounded=0;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=11;" edge="1" parent="1" source="p1c26" target="p1c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c35" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="p1c31" target="p1c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1c36" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue = .NET service&lt;br&gt;Green = own database (Oracle)&lt;br&gt;Solid arrow = direct call (REST)&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Red dashed = event via RabbitMQ&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Rule:&lt;/b&gt; each service has its own database.&lt;br&gt;Services never read another service's database." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#c0a000;align=left;verticalAlign=top;spacing=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1040" y="580.0" width="300" height="170" as="geometry"/></mxCell><mxCell id="c4" value="PART 2 of 6" style="rounded=0;html=1;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="1045.0" width="1300" height="36" as="geometry"/></mxCell><mxCell id="p2c1" value="Data Model (one database per service)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1085.0" width="700" height="40" as="geometry"/></mxCell><mxCell id="p2c2" value="Profile DB" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#3d7a3d;" vertex="1" parent="1"><mxGeometry x="30" y="1145.0" width="600" height="330" as="geometry"/></mxCell><mxCell id="p2c3" value="Customer" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="1185.0" width="230" height="30" as="geometry"/></mxCell><mxCell id="p2c4" value="&lt;b&gt;CustomerId (PK)&lt;/b&gt;&lt;br&gt;FirstName&lt;br&gt;LastName&lt;br&gt;Email&lt;br&gt;Phone&lt;br&gt;CreatedAt" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="1215.0" width="230" height="144" as="geometry"/></mxCell><mxCell id="p2c5" value="CustomerPhoto" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="1185.0" width="220" height="30" as="geometry"/></mxCell><mxCell id="p2c6" value="&lt;b&gt;PhotoId (PK)&lt;/b&gt;&lt;br&gt;CustomerId (FK)&lt;br&gt;Url&lt;br&gt;Format (jpg, png)&lt;br&gt;SizeBytes&lt;br&gt;UploadedAt" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="1215.0" width="220" height="144" as="geometry"/></mxCell><mxCell id="p2c7" value="1 : N" style="endArrow=ERmany;startArrow=ERone;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endSize=12;startSize=12;" edge="1" parent="1" source="p2c4" target="p2c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2c8" value="Transaction DB" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#3d7a3d;" vertex="1" parent="1"><mxGeometry x="680" y="1145.0" width="330" height="330" as="geometry"/></mxCell><mxCell id="p2c9" value="Transaction" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="710" y="1185.0" width="270" height="30" as="geometry"/></mxCell><mxCell id="p2c10" value="&lt;b&gt;TransactionId (PK)&lt;/b&gt;&lt;br&gt;CustomerId&lt;br&gt;AccountId&lt;br&gt;Type (Deposit / Withdrawal / Transfer)&lt;br&gt;Amount&lt;br&gt;Currency&lt;br&gt;Channel (ATM / Mobile)&lt;br&gt;CreatedAt" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="710" y="1215.0" width="270" height="188" as="geometry"/></mxCell><mxCell id="p2c11" value="Document DB" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#3d7a3d;" vertex="1" parent="1"><mxGeometry x="30" y="1515.0" width="330" height="330" as="geometry"/></mxCell><mxCell id="p2c12" value="LoanDocument" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="1555.0" width="270" height="30" as="geometry"/></mxCell><mxCell id="p2c13" value="&lt;b&gt;DocumentId (PK)&lt;/b&gt;&lt;br&gt;CustomerId&lt;br&gt;LoanApplicationId&lt;br&gt;DocumentType&lt;br&gt;Url&lt;br&gt;Format&lt;br&gt;SizeBytes&lt;br&gt;Status (Valid / Rejected)&lt;br&gt;UploadedAt" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="1585.0" width="270" height="210" as="geometry"/></mxCell><mxCell id="p2c14" value="Audit DB" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#3d7a3d;" vertex="1" parent="1"><mxGeometry x="400" y="1515.0" width="330" height="330" as="geometry"/></mxCell><mxCell id="p2c15" value="AuditLog" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="1555.0" width="270" height="30" as="geometry"/></mxCell><mxCell id="p2c16" value="&lt;b&gt;AuditId (PK)&lt;/b&gt;&lt;br&gt;EventType&lt;br&gt;ServiceName&lt;br&gt;Data (JSON)&lt;br&gt;CreatedAt" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="1585.0" width="270" height="122" as="geometry"/></mxCell><mxCell id="p2c17" value="&lt;b&gt;Millions of rows&lt;/b&gt;&lt;br&gt;- Transaction and AuditLog tables are &lt;b&gt;split by month&lt;/b&gt; (Oracle partitioning).&lt;br&gt;- Transactions are only &lt;b&gt;inserted&lt;/b&gt;, never updated - fast writes.&lt;br&gt;- Index on (CustomerId, CreatedAt) to find a customer's transactions.&lt;br&gt;- Files are stored in File Storage, only the &lt;b&gt;Url&lt;/b&gt; is in the database.&lt;br&gt;&lt;br&gt;&lt;b&gt;Write vs read (bonus)&lt;/b&gt;&lt;br&gt;- &lt;b&gt;Write:&lt;/b&gt; Oracle tables above (the truth).&lt;br&gt;- &lt;b&gt;Read:&lt;/b&gt; Redis keeps the &lt;b&gt;last 20 transactions&lt;/b&gt; per customer&lt;br&gt;&amp;nbsp;&amp;nbsp;(key: customer:{id}:transactions), so the mobile app loads instantly." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#c0a000;align=left;verticalAlign=top;spacing=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="1515.0" width="470" height="280" as="geometry"/></mxCell><mxCell id="c5" value="PART 3 of 6" style="rounded=0;html=1;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="1945.0" width="1300" height="36" as="geometry"/></mxCell><mxCell id="p3c15" value="Customer" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;size=40;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2045.0" width="130" height="660" as="geometry"/></mxCell><mxCell id="p3c16" value="Angular App" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="2045.0" width="130" height="660" as="geometry"/></mxCell><mxCell id="p3c17" value="API Gateway" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#dae8fc;strokeColor