ive="1" as="geometry"><mxPoint x="615" y="3990.0" as="sourcePoint"/><mxPoint x="445" y="3990.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5c11" value="400 Bad Request" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="445" y="4030.0" as="sourcePoint"/><mxPoint x="275" y="4030.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5c12" value="save file" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="4095.0" as="sourcePoint"/><mxPoint x="785" y="4095.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5c13" value="file URL" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="785" y="4135.0" as="sourcePoint"/><mxPoint x="615" y="4135.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5c14" value="save document info (Valid)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="4175.0" as="sourcePoint"/><mxPoint x="955" y="4175.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5c15" value="event: DocumentUploaded" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="4215.0" as="sourcePoint"/><mxPoint x="1125" y="4215.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5c16" value="201 Created + URL" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="4255.0" as="sourcePoint"/><mxPoint x="445" y="4255.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5c17" value="201 Created + URL" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="445" y="4295.0" as="sourcePoint"/><mxPoint x="275" y="4295.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="PART 6 of 6" style="rounded=0;html=1;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="4465.0" width="1300" height="36" as="geometry"/></mxCell><mxCell id="p6c1" value="Events, Fault Tolerance, Scaling, Decisions" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="4505.0" width="900" height="40" as="geometry"/></mxCell><mxCell id="p6c2" value="&lt;b&gt;Domain events (sent through RabbitMQ)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ProfileUpdated&lt;/b&gt; - Profile Service -&gt; Audit&lt;br&gt;&lt;b&gt;TransactionCreated&lt;/b&gt; - Transaction Service -&gt; Notification, Audit&lt;br&gt;&lt;b&gt;DocumentUploaded&lt;/b&gt; - Document Service -&gt; Notification, Audit&lt;br&gt;&lt;b&gt;DocumentRejected&lt;/b&gt; - Document Service -&gt; Notification&lt;br&gt;&lt;br&gt;Every event has: eventId, type, time, data." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#c0a000;align=left;verticalAlign=top;spacing=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="4565.0" width="620" height="200" as="geometry"/></mxCell><mxCell id="p6c3" value="&lt;b&gt;Fault tolerance&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Retry:&lt;/b&gt; if a call fails, try again 3 times (Polly library).&lt;br&gt;&lt;b&gt;Dead-letter queue:&lt;/b&gt; a message that fails 3 times goes to a separate queue to check later. Nothing is lost.&lt;br&gt;&lt;b&gt;No duplicates:&lt;/b&gt; every message has an eventId; if it was already saved, skip it.&lt;br&gt;&lt;b&gt;Errors:&lt;/b&gt; one error handler in every service returns clear error messages.&lt;br&gt;&lt;b&gt;Monitoring:&lt;/b&gt; health checks + logs + dashboards (Grafana), alert when queues grow or errors rise." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#c0a000;align=left;verticalAlign=top;spacing=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="4565.0" width="640" height="200" as="geometry"/></mxCell><mxCell id="p6c4" value="&lt;b&gt;Scalability&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;.NET services:&lt;/b&gt; run more copies behind the gateway (they keep no data in memory).&lt;br&gt;&lt;b&gt;RabbitMQ:&lt;/b&gt; cluster of 3 servers; more consumers share the same queue.&lt;br&gt;&lt;b&gt;Redis:&lt;/b&gt; Redis Cluster splits data across several servers.&lt;br&gt;&lt;b&gt;Oracle:&lt;/b&gt; tables split by month; old months archived." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#c0a000;align=left;verticalAlign=top;spacing=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="4805.0" width="620" height="180" as="geometry"/></mxCell><mxCell id="p6c5" value="&lt;b&gt;Why these choices?&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Microservices&lt;/b&gt; - each part scales alone (transactions are much busier than profiles).&lt;br&gt;&lt;b&gt;Database per service&lt;/b&gt; - a change in one service does not break others.&lt;br&gt;&lt;b&gt;RabbitMQ&lt;/b&gt; - ATM gets an instant answer; if the database is slow, messages wait safely in the queue.&lt;br&gt;&lt;b&gt;Ocelot&lt;/b&gt; - one entry point for all apps, written in .NET.&lt;br&gt;&lt;b&gt;Redis&lt;/b&gt; - very fast reads for the mobile app.&lt;br&gt;&lt;b&gt;File Storage&lt;/b&gt; - big files kept outside Oracle so the database stays small and fast." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#c0a000;align=left;verticalAlign=top;spacing=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="4805.0" width="640" height="220" as="geometry"/></mxCell><mxCell id="p6c6" value="&lt;b&gt;Rejected alternatives&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;One big app (monolith)&lt;/b&gt; - simple, but one bug can stop everything and it can't scale parts separately.&lt;br&gt;&lt;b&gt;One shared database&lt;/b&gt; - easy joins, but services become tightly connected.&lt;br&gt;&lt;b&gt;Kafka&lt;/b&gt; - powerful, but more complex to run; RabbitMQ is enough here.&lt;br&gt;&lt;b&gt;Files inside Oracle&lt;/b&gt; - database becomes huge and slow to back up." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#c0a000;align=left;verticalAlign=top;spacing=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="5025.0" width="620" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>